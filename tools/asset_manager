#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python_bin="$project_dir/.venv/bin/python3"
if [ ! -x "$python_bin" ]; then python_bin=python3; fi
# Compatibility alias; service.py canonicalizes this to mtos_asset.
exec "$python_bin" "$project_dir/tools/service.py" --service mtos_asset "$@"
